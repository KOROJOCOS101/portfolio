<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="400.0"
      stylesheets="@../css/styles.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cafeteriaapp.resources.controllers.ProfileController">

    <VBox style="-fx-background-color: #2f4f4f;" prefHeight="160.0" prefWidth="400.0">
        <padding>
            <Insets top="30.0" left="24.0" right="24.0" bottom="24.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <VBox alignment="CENTER"
                  style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 40;"
                  minWidth="64.0" minHeight="64.0" maxWidth="64.0" maxHeight="64.0">
                <FontAwesomeIconView glyphName="USER" size="28" fill="WHITE"/>
            </VBox>

            <VBox spacing="4.0">
                <Label fx:id="fullNameLabel" text="Full Name"
                       textFill="WHITE">
                    <font><Font name="System Bold" size="20.0"/></font>
                </Label>
                <Label fx:id="emailLabel" text="email@example.com"
                       style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 13px;"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox VBox.vgrow="ALWAYS" spacing="0.0"
          style="-fx-background-color: #f8f9fa;">

        <HBox styleClass="profile-row" alignment="CENTER_LEFT"
              onMouseClicked="#handleViewWallet"
              style="-fx-background-color: white; -fx-padding: 18 24 18 24; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0; -fx-cursor: hand;">
            <VBox alignment="CENTER"
                  style="-fx-background-color: #eef2ff; -fx-background-radius: 10;"
                  minWidth="38.0" minHeight="38.0" maxWidth="38.0" maxHeight="38.0">
                <FontAwesomeIconView glyphName="CREDIT_CARD" size="16" fill="#3b5bdb"/>
            </VBox>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <HBox.margin><Insets left="14.0"/></HBox.margin>
                <Label text="My Wallet"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2f4f4f;"/>
                <Label text="View and top up your balance"
                       style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
            </VBox>
            <FontAwesomeIconView glyphName="ANGLE_RIGHT" size="16" fill="#9ca3af"/>
        </HBox>

        <HBox styleClass="profile-row" alignment="CENTER_LEFT"
              onMouseClicked="#handleViewOrderHistory"
              style="-fx-background-color: white; -fx-padding: 18 24 18 24; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0; -fx-cursor: hand;">
            <VBox alignment="CENTER"
                  style="-fx-background-color: #eef2ff; -fx-background-radius: 10;"
                  minWidth="38.0" minHeight="38.0" maxWidth="38.0" maxHeight="38.0">
                <FontAwesomeIconView glyphName="LIST" size="16" fill="#3b5bdb"/>
            </VBox>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <HBox.margin><Insets left="14.0"/></HBox.margin>
                <Label text="Order History"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2f4f4f;"/>
                <Label text="View your past orders"
                       style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
            </VBox>
            <FontAwesomeIconView glyphName="ANGLE_RIGHT" size="16" fill="#9ca3af"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox style="-fx-background-color: white; -fx-padding: 20 24 20 24;">
            <Button text="Sign Out" onAction="#handleSignOut"
                    maxWidth="Infinity"
                    style="-fx-background-color: #fff0f0; -fx-text-fill: #e53e3e; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 13 0; -fx-cursor: hand;"/>
        </VBox>

    </VBox>

</VBox>
